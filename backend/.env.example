# ============================================================
# DATABASE — MySQL
# Thay user/password/host theo cấu hình MySQL của bạn
# ============================================================
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/diabetes_db
#ví dụ: DATABASE_URL=mysql+pymysql://root:123456789@localhost:3306/diabetes_db

# Ví dụ cho user riêng đã tạo theo hướng dẫn database/README.md:
# DATABASE_URL=mysql+pymysql://diabetes_user:StrongPassword123!@localhost:3306/diabetes_db

# ============================================================
# JWT SECRET — BẮT BUỘC ĐỔI khi deploy production
# Sinh chuỗi random: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================
SECRET_KEY=your_random_secret_key_here
# ví dụ: SECRET_KEY=9f8b7c6d5e4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6g5h4i3j2k1l0m 
ALGORITHM=HS256

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=30

# AI Service URL (cung cấp cho frontend)
AI_SERVICE_URL=http://localhost:8000

# CORS — origin của frontend (Vite default port 5173)
FRONTEND_ORIGIN=http://localhost:5173
